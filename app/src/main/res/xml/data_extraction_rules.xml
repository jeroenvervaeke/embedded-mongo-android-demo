<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31 and above. allowBackup="false" stops the cloud half; on these versions a device-to-device
  transfer is a separate decision, and it is the one that matters most here. The whole hazard is
  a WiredTiger directory arriving on a phone whose engine build did not write it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="coffee" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="coffee" />
    </device-transfer>
</data-extraction-rules>
